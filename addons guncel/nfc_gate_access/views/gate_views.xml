<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kapı Yönetimi Listesi -->
    <record id="view_nfc_gate_tree" model="ir.ui.view">
        <field name="name">nfc.gate.tree</field>
        <field name="model">nfc.gate</field>
        <field name="arch" type="xml">
            <list string="Kapi Yonetimi">
                <field name="name"/>
                <field name="code"/>
                <field name="nfc_card_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Kapı Form Görünümü -->
    <record id="view_nfc_gate_form" model="ir.ui.view">
        <field name="name">nfc.gate.form</field>
        <field name="model">nfc.gate</field>
        <field name="arch" type="xml">
            <form string="Kapi">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="nfc_card_id" placeholder="Örn: 04:A2:3B:1C"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                    </group>
                    <notebook>
                        <page string="Yetkili Calisanlar" name="authorized_employees">
                            <field name="employee_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Eylemler (Actions) -->
    <record id="action_nfc_gate" model="ir.actions.act_window">
        <field name="name">Tum Kapilar</field>
        <field name="res_model">nfc.gate</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_device_employee_mapping" model="ir.actions.act_window">
        <field name="name">Cihaz &amp; Kart Eslestirmeleri</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_nfc_card_writer" model="ir.actions.act_url">
        <field name="name">NFC Kart Programla</field>
        <field name="url">https://blunt-humpback-unjustly.ngrok-free.dev/nfc/admin/write-card</field>
        <field name="target">new</field>
    </record>

    <!-- Menü Ağacı -->
    <menuitem id="menu_nfc_gate_root" name="Gate Access" sequence="10" web_icon="nfc_gate_access,static/description/icon.png"/>
    
    <menuitem id="menu_nfc_gate_all" name="Tum Kapilar" parent="menu_nfc_gate_root" action="action_nfc_gate" sequence="10"/>
    <menuitem id="menu_nfc_employee_mapping" name="Cihaz &amp; Kart Eslestirmeleri" parent="menu_nfc_gate_root" action="action_device_employee_mapping" sequence="20"/>
    <menuitem id="menu_nfc_card_writer" name="NFC Kart Programla" parent="menu_nfc_gate_root" action="action_nfc_card_writer" sequence="30"/>
</odoo>
