<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_gate_access" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.gate.access</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Gate Access" name="gate_access_tab">
                    <group string="Turnstile &amp; Gate Permissions">
                        <field name="allowed_gate_ids" widget="many2many_tags" placeholder="Personelin yetkili olduğu kapıları seçin..."/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
